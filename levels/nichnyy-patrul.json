{
  "id": "nichnyy-patrul",
  "name": "Нічний патруль",
  "description": "Обійди площу по колу, повертаючи перед деревами, і засвіти лише згаслі ліхтарі.",
  "descriptionNight": "На площі 8 ліхтарів по периметру, частина з них уже світиться. Обійди площу за один цикл і увімкни решту.",
  "descriptionDay": "Обійди площу по периметру та вимкни всі ліхтарі, що досі світяться.",
  "category": "conditions",
  "difficulty": 2,
  "width": 5,
  "depth": 5,
  "start": {
    "x": 1,
    "z": 3,
    "dir": 0
  },
  "allowed": [
    "forward",
    "right",
    "light",
    "loop",
    "if"
  ],
  "allowElif": false,
  "allowElse": false,
  "allowedSensors": [
    "obstacleAhead",
    "lampLit"
  ],
  "hints": [
    {
      "text": "Дерева за рогами площі підкажуть датчику «Попереду перешкода», коли час повертати праворуч.",
      "target": "scene",
      "textEn": "Trees behind the corners of the plaza tell the \"Obstacle ahead\" sensor when it is time to turn right."
    },
    {
      "text": "Використай умову «НЕ Світло тут світить», щоб не гасити ліхтарі, які вже горять.",
      "target": "command:if",
      "textEn": "Use the condition \"NOT Light is on here\" so you do not turn off streetlamps that are already lit."
    }
  ],
  "limit": 8,
  "repairKits": 0,
