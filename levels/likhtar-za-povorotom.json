{
  "id": "likhtar-za-povorotom",
  "name": "Ліхтар за поворотом",
  "description": "Стежка має один поворот. Кожну пряму ділянку можна пройти одним циклом «Поки».",
  "descriptionNight": "Дійди до дерева, поверни праворуч, дійди до наступного дерева й запали ліхтар.",
  "descriptionDay": "Дійди до дерева, поверни праворуч, дійди до наступного дерева й вимкни ліхтар.",
  "category": "lists",
  "difficulty": 2,
  "width": 6,
  "depth": 6,
  "start": {
    "x": 0,
    "z": 5,
    "dir": 0
  },
  "allowed": [
    "forward",
    "right",
    "light",
    "while"
  ],
  "allowElif": false,
  "allowElse": false,
  "allowedSensors": [
    "obstacleAhead"
  ],
  "hints": [
    {
      "text": "Програма складається з двох однакових циклів «Поки», між якими — поворот «Вправо».",
      "textEn": "The program consists of two identical \"While\" loops with a \"Right\" turn between them.",
      "target": "program"
    }
  ],
  "limit": 6,
