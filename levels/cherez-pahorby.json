  "allowed": [
    "right",
    "jump",
    "light",
    "loop",
    "if"
  ],
  "allowElif": false,
  "allowElse": true,
  "allowedSensors": [
    "canJump",
    "onLamp"
  ],
  "hints": [
    {
      "text": "На кутах стежки лежать валуни, тому просто стрибати вперед не можна. Використай «Якщо Можна стрибнути -> Стрибок, інакше -> Праворуч» та окрему перевірку «Тут є ліхтар чи будинок».",
      "target": "command:jump",
      "textEn": "Boulders block the corners of the path, so you cannot just jump straight ahead. Use \"If Can jump -> Jump, else -> Turn right\" and a separate \"At lantern or house\" check."
    }
  ],
