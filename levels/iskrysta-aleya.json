    "lampShorts"
  ],
  "hints": [
    {
      "text": "У тебе є 2 ремкомплекти. Датчик «Ліхтар коротить» підкаже, коли потрібно використати команду «Полагодити».",
      "target": "command:fix",
      "textEn": "You have 2 repair kits. The \"Lamp is sparking\" sensor tells you when to use the \"Repair\" command."
    },
    {
      "text": "Після блоку «Якщо» додай команду «Запалити ліхтар», щоб засвічувати кожен ліхтар на шляху.",
      "target": "command:light",
      "textEn": "After the \"If\" block, add the \"Light lamp\" command to light every streetlamp along the way."
    }
  ],
  "limit": 6,
  "repairKits": 2,
