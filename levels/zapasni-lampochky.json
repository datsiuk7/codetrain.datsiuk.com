{
  "id": "zapasni-lampochky",
  "name": "Запасні лампочки",
  "description": "Збирай запасні лампочки на плитках без ліхтарів і вкручуй їх у порожні ліхтарі.",
  "descriptionNight": "На кожній плитці попереду або лежить лампочка, або стоїть ліхтар. Якщо є ліхтар — запали його, інакше — візьми лампочку!",
  "descriptionDay": "Збери запасні лампочки та впорядкуй усі ліхтарі на прямій алеї.",
  "category": "conditions",
  "difficulty": 2,
  "width": 3,
  "depth": 7,
  "start": {
    "x": 1,
    "z": 6,
    "dir": 0
  },
  "allowed": [
    "forward",
    "light",
    "take",
    "loop",
    "if"
  ],
  "allowElif": false,
  "allowElse": true,
  "allowedSensors": [
    "onLamp"
  ],
  "hints": [
    {
      "text": "Додай гілку «Інакше» (else) до перевірки «Тут є ліхтар чи будинок»: на плитці з ліхтарем вмикай світло, а на порожній — бери лампочку.",
      "target": "command:if",
      "textEn": "Add an \"Else\" branch to the \"Light source here\" check: on a tile with a lamp, toggle the light; on an empty tile, pick up the bulb."
    }
  ],
  "limit": 6,
