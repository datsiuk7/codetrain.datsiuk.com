{
  "id": "povorot-bilya-sosny",
  "name": "Поворот біля сосни",
  "description": "Дійди до ліхтаря звивистою стежкою, повертаючи праворуч перед кожною сосною.",
  "descriptionNight": "Використай датчик «Попереду перешкода» всередині циклу, щоб двічі повернути праворуч біля сосен різної відстані та дійти до ліхтаря.",
  "descriptionDay": "Обійди сосни за допомогою перевірки перешкоди попереду та вимкни ліхтар у кінці доріжки.",
  "category": "conditions",
  "difficulty": 1,
  "width": 6,
  "depth": 6,
  "start": {
    "x": 1,
    "z": 4,
    "dir": 0
  },
  "allowed": [
    "forward",
    "right",
    "light",
    "loop",
    "if"
  ],
  "allowElif": false,
  "allowElse": false,
  "allowedSensors": [
    "obstacleAhead"
  ],
  "hints": [
    {
      "text": "Відстані між поворотами різні (3 кроки, потім 3 кроки, потім 2 кроки), тому простий подвійний цикл не підійде. Перевіряй «Попереду перешкода» на кожному з 8 кроків!",
      "target": "command:if",
      "textEn": "The distances between turns are different (3 steps, then 3 steps, then 2 steps), so a simple nested loop will not work. Check \"Obstacle ahead\" on each of the 8 steps!"
    }
  ],
  "limit": 5,
  "repairKits": 0,
