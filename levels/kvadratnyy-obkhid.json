  ],
  "hints": [
    {
      "text": "Цикл «Поки» вкладається в звичайний цикл: «4 рази: {Поки НЕ перешкода: крок і лампа}, Вправо».",
      "textEn": "A \"While\" loop nests inside a regular loop: \"4 times: {While NOT obstacle: step and lamp}, Right\".",
      "target": "command:loop"
    }
  ],
