    "obstacleAhead",
    "onLamp"
  ],
  "hints": [
    {
      "text": "Усередині циклу на 7 повторень спочатку перевір, чи не час повернути праворуч, потім зроби крок уперед і перевір наявність ліхтаря.",
      "target": "command:if",
      "textEn": "Inside a 7-repeat loop, first check if it is time to turn right, then step forward and check for a streetlamp."
    }
  ],
